<div id={@quote.permalink} class="card mb-4">
  <div class="card-body">
    <section>
      <%= if @quote.text_rendered != nil do %>
        {raw(@quote.text_rendered)}
      <% else %>
        <p>{@quote.text}</p>
      <% end %>
    </section>

    <%= if @quote.source do %>
      <p class="font-italic font-weight-light">
        Source:
        <%= if is_link?(@quote.source) do %>
          <a href={@quote.source} target="_blank">
            {@quote.source}
          </a>
        <% else %>
          {@quote.source}
        <% end %>
      </p>
    <% end %>

    <%= if @show_author do %>
      <div class="float-left">
        <.link href={~p"/quotes/authors/#{@quote.author.slug}"}>{@quote.author.name}</.link>
      </div>
    <% end %>

    <div class={actions_class(@show_author)}>
      <.link href={~p"/quotes/#{@quote.permalink}"} class="text-secondary">Permalink</.link>

      <%= if signed_in?(@conn) do %>
        &middot; <.link href={~p"/quotes/#{@quote.id}/edit"} class="text-secondary">Edit</.link>
        &middot;
        <.link
          href={~p"/quotes/#{@quote.id}"}
          method="delete"
          class="text-danger"
          data-confirm="Really delete?"
        >
          Delete
        </.link>
      <% end %>
    </div>

    <div class="clearfix"></div>
  </div>
</div>
